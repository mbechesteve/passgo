# PassGo stores all data locally on-device (AsyncStorage / localStorage) — there
# is no backend to configure. Only these optional keys remain:

# Google Maps (Directions + Maps SDK). Also add the platform keys to app.json.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-key

# RevenueCat (Premium / in-app purchases). Placeholder for now.
EXPO_PUBLIC_REVENUECAT_API_KEY=your-revenuecat-public-key
