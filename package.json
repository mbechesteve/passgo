{
  "name": "pamoja",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "dev": "npm run build:portal-bundle && node scripts/dev-server.mjs",
    "web": "npm run dev",
    "build:portal-bundle": "node scripts/build-portal-bundle.mjs",
    "build": "npm run build:portal-bundle && expo export --platform web --output-dir dist/app && node scripts/copy-portal.mjs && node scripts/inject-pwa.mjs",
    "verify:bundle": "node scripts/verify-bundle.mjs",
    "verify:contrast": "node scripts/verify-contrast.mjs",
    "verify:portal": "npm run build:portal-bundle && node scripts/verify-portal.mjs",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "web:app": "expo start --web",
    "portal": "npm run build:portal-bundle && python3 -m http.server 8080 --directory portal"
  },
  "dependencies": {
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@expo-google-fonts/outfit": "^0.4.3",
    "@expo/metro-runtime": "~3.2.3",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-navigation/bottom-tabs": "^6.6.1",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.11.0",
    "expo": "~51.0.28",
    "expo-constants": "~16.0.2",
    "expo-font": "~12.0.10",
    "expo-image": "~1.13.0",
    "expo-linear-gradient": "~13.0.2",
    "expo-status-bar": "~1.12.1",
    "nativewind": "4.1.23",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native": "0.74.5",
    "react-native-draggable-flatlist": "^4.0.1",
    "react-native-gesture-handler": "~2.16.1",
    "react-native-maps": "1.14.0",
    "react-native-reanimated": "~3.10.1",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "3.31.1",
    "react-native-svg": "15.2.0",
    "react-native-web": "~0.19.10",
    "tailwindcss": "^3.4.10",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@types/react": "~18.2.79",
    "babel-plugin-module-resolver": "^5.0.2",
    "esbuild": "^0.21.5",
    "typescript": "~5.3.3",
    "vitest": "^2.1.9"
  },
  "overrides": {
    "react-native-css-interop": "0.1.22"
  },
  "private": true
}
